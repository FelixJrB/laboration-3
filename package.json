{
  "name": "laboration-3",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:match": "vitest run -t",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier ./src --check",
    "docker:prod": "docker compose -f docker-compose.yaml -f docker-compose.prod.yaml up -d --build",
    "docker:down": "docker compose -f docker-compose.yaml -f docker-compose.prod.yaml down"
  },
  "prettier": "@lnu/prettier-config",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "midgard-hex-grid": "^1.0.0",
    "visitor-module": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lnu/eslint-config": "^3.0.1",
    "@lnu/prettier-config": "^1.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.3.11",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-regexp": "^3.3.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
